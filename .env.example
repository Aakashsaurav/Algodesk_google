# AlgoDesk Environment Configuration (.env.example)
# Copy to `.env` for local MacBook / Linux deployment. Never commit `.env` to Git.

# Server Network Binding
# Local runs bind to loopback (127.0.0.1) by default. Set HOST=0.0.0.0 only behind a trusted VPN/proxy.
HOST="127.0.0.1"
# PORT="3000"

# Broker Credentials (Upstox & Zerodha Kite)
# Keep ALGODESK_USE_KEYCHAIN="false" (default) to store tokens/secrets in local 0o600 files
# without triggering macOS Keychain password prompts on unsigned Python runs.
ALGODESK_USE_KEYCHAIN="false"
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_REDIRECT_URI="https://127.0.0.1:5000/"
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""
ZERODHA_REDIRECT_URI="http://127.0.0.1:8000/auth/zerodha/callback"

# Production Safety & Access Controls
# Real broker order dispatch stays DISABLED until explicitly set to "true".
ALGODESK_ENABLE_LIVE_TRADING="false"

# Auth is ENFORCED BY DEFAULT across all /api/* routes (deny-by-default).
# Set ALGODESK_API_TOKEN for a static Bearer token, OR leave blank to claim an operator
# passcode using the one-time server bootstrap code printed on first boot (data/.bootstrap_code).
ALGODESK_REQUIRE_AUTH="true"
ALGODESK_API_TOKEN=""

# Optional Outbound Telegram Bot Notifications (works behind home Wi-Fi/NAT with zero open ports)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_ID=""
