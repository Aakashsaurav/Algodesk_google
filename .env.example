# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local AlgoDesk Broker Credentials (for local MacBook Air M2 deployment in .env)
# Keep ALGODESK_USE_KEYCHAIN="false" (default) to store tokens/secrets in local 0o600 files
# without triggering macOS Keychain password prompts on unsigned Python runs.
# ALGODESK_USE_KEYCHAIN="false"
# UPSTOX_API_KEY=""
# UPSTOX_API_SECRET=""
# UPSTOX_REDIRECT_URI="https://127.0.0.1:5000/"
# ZERODHA_API_KEY=""
# ZERODHA_API_SECRET=""
# ZERODHA_REDIRECT_URI="http://127.0.0.1:8000/auth/zerodha/callback"

# Production Safety & Access Controls
# Real broker order dispatch stays DISABLED until explicitly set to "true".
ALGODESK_ENABLE_LIVE_TRADING="false"
# Optional static Bearer token for mutating trading/plugin APIs (or claim a passcode in UI)
ALGODESK_API_TOKEN=""
ALGODESK_REQUIRE_AUTH="false"

# Outbound Telegram Bot Notifications (works behind MacBook Wi-Fi/NAT with zero open ports)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_ID=""

